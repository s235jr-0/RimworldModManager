<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ghud.App.ViewModels"
             x:Class="Ghud.App.Views.GameView"
             x:DataType="vm:GameViewModel">

  <DockPanel Margin="12,10">

    <!-- Header: back, name, profile, deploy -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
      <Button Content="← Games" Command="{Binding BackCommand}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding GameName}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ModuleName}" Opacity="0.7" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="Profile" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="150"
                  IsEnabled="{Binding Main.IsNotBusy}" AutomationProperties.Name="Profile" />
        <Button Content="New" Command="{Binding NewProfileCommand}" IsEnabled="{Binding Main.IsNotBusy}" />
        <Button Content="Rename" Command="{Binding RenameProfileCommand}" IsEnabled="{Binding Main.IsNotBusy}" />
        <Button Content="Delete" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding Main.IsNotBusy}" />
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Content="Deploy" Command="{Binding DeployCommand}" Classes="accent" MinWidth="100" IsEnabled="{Binding Main.IsNotBusy}"
                ToolTip.Tip="Make the game folder match the switched-on mods of this profile." />
        <Button Content="Undeploy" Command="{Binding UndeployCommand}" IsEnabled="{Binding Main.IsNotBusy}"
                ToolTip.Tip="Take every GHUD mod file out of the game and restore the game's own files." />
      </StackPanel>
    </Grid>

    <!-- Folders + deploy state -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBlock Text="{Binding FoldersText}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding DeployHint}" Foreground="{DynamicResource Theme.StatusAttention}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding DeployedText}" Opacity="0.75" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Downloads to finish in the browser -->
    <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasPending}" Padding="10,8" CornerRadius="6" Margin="0,8,0,0"
            BorderThickness="1" BorderBrush="{DynamicResource Theme.StatusWorking}">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
        <TextBlock Text="Waiting for you to finish these in your browser:" FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.StatusWorking}" />
        <Button Grid.Column="1" Content="Stop waiting" Command="{Binding ClearPendingCommand}" />
        <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Pending}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PendingDownload">
              <TextBlock Text="{Binding Text, StringFormat='• {0}'}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <!-- Install box -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
      <TextBox Text="{Binding LinksInput}" AcceptsReturn="True" Height="64" AutomationProperties.Name="Links"
               PlaceholderText="Paste links, one per line: GitHub, GitLab / GitGud, Nexus, MEGA, MediaFire, Google Drive, Dropbox, direct files..."
               FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <StackPanel Grid.Column="1" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Paste" Command="{Binding PasteCommand}" />
          <Button Content="Install links" Command="{Binding InstallLinksCommand}" Classes="accent" IsEnabled="{Binding Main.IsNotBusy}" />
        </StackPanel>
        <Button Content="Install from file..." Command="{Binding InstallFromFileCommand}" IsEnabled="{Binding Main.IsNotBusy}"
                HorizontalAlignment="Stretch" />
      </StackPanel>
    </Grid>

    <!-- Mod list + details -->
    <Grid ColumnDefinitions="*,330" ColumnSpacing="10" Margin="0,8,0,0">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Top" ItemSpacing="6" LineSpacing="6" Margin="0,0,0,6">
          <Button Content="Check updates" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding Main.IsNotBusy}" />
          <Button Content="Update selected" Command="{Binding UpdateSelectedCommand}" IsEnabled="{Binding HasSelection}" />
          <Button Content="Update outdated" Command="{Binding UpdateOutdatedCommand}" IsEnabled="{Binding Main.IsNotBusy}"
                  ToolTip.Tip="Updates every mod marked Update or Unknown." />
          <Button Content="Clean up library..." Command="{Binding CleanupLibraryCommand}" IsEnabled="{Binding Main.IsNotBusy}"
                  ToolTip.Tip="Delete old archives from the download library." />
          <Button Content="Export..." Command="{Binding ExportCommand}" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding LoadOrderHint}" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single"
                  AutomationProperties.Name="Mods">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="44" IsReadOnly="True" x:DataType="vm:ModRow" />
            <DataGridTemplateColumn Header="On" Width="64">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ModRow">
                  <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center"
                            IsEnabled="{Binding $parent[UserControl].((vm:GameViewModel)DataContext).Main.IsNotBusy}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="2*" IsReadOnly="True" x:DataType="vm:ModRow" />
            <DataGridTemplateColumn Header="Source" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ModRow">
                  <Border Classes="sourcetag" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding SourceTag}" FontSize="12" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" IsReadOnly="True" x:DataType="vm:ModRow" />
            <DataGridTextColumn Header="Update" Binding="{Binding UpdateText}" Width="*" IsReadOnly="True" x:DataType="vm:ModRow" />
            <DataGridTextColumn Header="Conflicts" Binding="{Binding ConflictText}" Width="*" IsReadOnly="True" x:DataType="vm:ModRow" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <DockPanel Grid.Column="1">
        <WrapPanel DockPanel.Dock="Top" ItemSpacing="6" LineSpacing="6" Margin="0,0,0,8">
          <Button Content="Top" Command="{Binding MoveTopCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Lowest priority" />
          <Button Content="Up" Command="{Binding MoveUpCommand}" IsEnabled="{Binding HasSelection}" />
          <Button Content="Down" Command="{Binding MoveDownCommand}" IsEnabled="{Binding HasSelection}" />
          <Button Content="Bottom" Command="{Binding MoveBottomCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Highest priority" />
          <Button Content="Remove" Command="{Binding RemoveModCommand}" IsEnabled="{Binding HasSelection}" />
          <Button Content="Roll back..." Command="{Binding RollBackCommand}" IsEnabled="{Binding CanRollBack}"
                  ToolTip.Tip="Go back to an earlier version from the download library." />
          <CheckBox Content="Keep all versions" IsChecked="{Binding SelectedKeepAll}" IsEnabled="{Binding HasSelection}"
                    ToolTip.Tip="Library cleanup never deletes this mod's archives." />
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
          <Button Content="Game folder" Command="{Binding OpenGameFolderCommand}" />
          <Button Content="Staging" Command="{Binding OpenStagingCommand}" />
          <Button Content="Downloads" Command="{Binding OpenLibraryCommand}" />
          <Button Content="Remove game..." Command="{Binding RemoveGameCommand}" IsEnabled="{Binding Main.IsNotBusy}" />
        </WrapPanel>
        <Border BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}" CornerRadius="6" Background="{DynamicResource Theme.Surface}">
          <ScrollViewer Padding="10,8">
            <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                 FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>

</UserControl>
