<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ghud.App.ViewModels"
        xmlns:views="using:Ghud.App.Views"
        xmlns:dk="using:DownloadKit"
        x:Class="Ghud.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/AppIcon.ico"
        Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <!-- Each page's view model picks its view. -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:AddGameViewModel"><views:AddGameView /></DataTemplate>
    <DataTemplate DataType="vm:AccountsViewModel"><views:AccountsView /></DataTemplate>
    <DataTemplate DataType="vm:GameViewModel"><views:GameView /></DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="10,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Theme.Border}">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Log, collapsed by default -->
    <Expander DockPanel.Dock="Bottom" Header="Log" HorizontalAlignment="Stretch" Margin="8,0,8,4">
      <Border Background="{DynamicResource Theme.LogBackground}" CornerRadius="6" Height="170">
        <ScrollViewer Padding="8,4">
          <ItemsControl ItemsSource="{Binding LogLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dk:LogLine">
                <SelectableTextBlock Classes="log" Tag="{Binding Role}" Text="{Binding Text}"
                                     FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Expander>

    <ContentControl Content="{Binding CurrentPage}" />
  </DockPanel>

</Window>
