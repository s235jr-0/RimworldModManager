<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ghud.App.ViewModels"
             x:Class="Ghud.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <DockPanel Margin="24,18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
      <Image Source="/Assets/AppIcon.png" Width="48" Height="48" />
      <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
        <TextBlock Text="G.H.U.D." FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="General Hotfix Universal Downloader: pick a game" Opacity="0.75" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Accounts" Command="{Binding AccountsCommand}" />
        <Button Content="Log folder" Command="{Binding Main.OpenLogFolderCommand}" />
        <Button Content="About" Command="{Binding Main.AboutCommand}" />
      </StackPanel>
    </Grid>

    <ScrollViewer>
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Games}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GameTile">
              <Button Classes="tile" AutomationProperties.Name="{Binding Name}"
                      Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenCommand}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding Instance.GameFolder}">
                <StackPanel Spacing="8">
                  <Border Classes="tileicon" Background="{Binding TileBrush}">
                    <TextBlock Text="{Binding Initials}" FontSize="28" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Subtitle}" HorizontalAlignment="Center" Opacity="0.65" FontSize="12" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Classes="tile" Command="{Binding AddGameCommand}" AutomationProperties.Name="Add game">
          <StackPanel Spacing="8">
            <Border Classes="tileicon" BorderThickness="2" BorderBrush="{DynamicResource Theme.Border}">
              <TextBlock Text="+" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
            </Border>
            <TextBlock Text="Add game" HorizontalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="RimWorld or any other" HorizontalAlignment="Center" Opacity="0.65" FontSize="12" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>

</UserControl>
