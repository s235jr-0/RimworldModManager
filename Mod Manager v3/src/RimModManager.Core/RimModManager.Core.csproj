<Project Sdk="Microsoft.NET.Sdk">

  <!-- All mod-manager logic. No UI code, so it can be tested on its own and
       runs the same on Windows and Linux. -->
  <PropertyGroup>
    <RootNamespace>RimModManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RimModManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Downloads, archives, file safety, logging, colour schemes (frozen copy of GHUD's DownloadKit) -->
    <ProjectReference Include="..\DownloadKit.Core\DownloadKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DownloadKit" />
    <Using Include="DownloadKit.Sources" />
  </ItemGroup>

</Project>
