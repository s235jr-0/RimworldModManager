<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RimModManager.App.ViewModels"
             xmlns:core="using:RimModManager.Core"
             xmlns:cp="using:Avalonia.Controls.Primitives"
             x:Class="RimModManager.App.Views.AppearanceView"
             x:DataType="vm:MainViewModel">

  <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="10">

    <!-- Scheme picker + actions -->
    <WrapPanel Grid.Row="0" ItemSpacing="8" LineSpacing="6">
      <TextBlock Text="Colour scheme:" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Schemes}" SelectedItem="{Binding SelectedScheme}" MinWidth="240">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="core:ColorScheme">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Duplicate" Command="{Binding DuplicateSchemeCommand}" Classes="accent" />
      <Button Content="Rename..." Command="{Binding RenameSchemeCommand}" IsEnabled="{Binding IsEditable}" />
      <Button Content="Delete" Command="{Binding DeleteSchemeCommand}" IsEnabled="{Binding IsEditable}" />
      <Button Content="Import..." Command="{Binding ImportSchemeCommand}" />
      <Button Content="Export..." Command="{Binding ExportSchemeCommand}" />
    </WrapPanel>

    <TextBlock Grid.Row="1" Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding IsReadOnlyScheme}"
               Text="Built-in schemes can't be changed. Press Duplicate to make your own copy, then pick a colour below and edit it." />
    <TextBlock Grid.Row="1" Opacity="0.8" TextWrapping="Wrap" IsVisible="{Binding IsEditable}"
               Text="Pick a colour on the left, then use the wheel or type a hex / RGB value. Changes apply and save right away." />

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">

      <!-- Colour roles -->
      <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
               Background="{DynamicResource Theme.Surface}" CornerRadius="6">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RoleItem">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Group}" IsVisible="{Binding ShowGroupHeader}"
                         FontWeight="SemiBold" Opacity="0.7" Margin="0,6,0,2" />
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Width="34" Height="20" CornerRadius="5" Background="{Binding Brush}"
                        BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Hex}" VerticalAlignment="Center" Opacity="0.7"
                           FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Colour wheel + brightness, and typed hex / RGB, all in sync -->
      <StackPanel Grid.Column="1" Width="400" Spacing="14" IsEnabled="{Binding IsEditable}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <cp:ColorSpectrum Height="300" Shape="Ring" Components="HueSaturation"
                            Color="{Binding EditColor}" />
          <cp:ColorSlider Grid.Column="1" Width="26" Orientation="Vertical"
                          ColorModel="Hsva" ColorComponent="Component3"
                          IsAlphaVisible="False" Color="{Binding EditColor}"
                          ToolTip.Tip="Brightness" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
          <TextBlock Text="Hex" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding EditHex}" AutomationProperties.Name="Hex" MaxLength="7" PlaceholderText="#RRGGBB"
                   FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" />

          <TextBlock Grid.Row="1" Text="RGB" VerticalAlignment="Center" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Value="{Binding EditR}" AutomationProperties.Name="Red" Minimum="0" Maximum="255" Increment="1" FormatString="0" Width="110" />
            <NumericUpDown Value="{Binding EditG}" AutomationProperties.Name="Green" Minimum="0" Maximum="255" Increment="1" FormatString="0" Width="110" />
            <NumericUpDown Value="{Binding EditB}" AutomationProperties.Name="Blue" Minimum="0" Maximum="255" Increment="1" FormatString="0" Width="110" />
          </StackPanel>
        </Grid>

        <Border Height="44" CornerRadius="8" Background="{Binding SelectedRole.Brush, FallbackValue={x:Null}}"
                BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}" />
      </StackPanel>
    </Grid>
  </Grid>

</UserControl>
