<Project Sdk="Microsoft.NET.Sdk">

  <!-- Automated tests for the core. Run from the "Mod Manager v3" folder:
         dotnet test -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RimModManager.Core\RimModManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Small sample archives (7z / rar) for the unpacking tests. -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DownloadKit" />
    <Using Include="DownloadKit.Sources" />
  </ItemGroup>

</Project>
